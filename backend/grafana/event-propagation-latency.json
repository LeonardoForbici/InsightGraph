{
  "title": "InsightGraph - Event Propagation Latency",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "p95 Propagation Latency",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ig_event_propagation_latency_seconds_bucket[5m])) by (le, event_type))"
        }
      ],
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Batch Size",
      "targets": [
        {
          "expr": "histogram_quantile(0.9, sum(rate(ig_event_batch_size_bucket[5m])) by (le))"
        }
      ],
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 }
    }
  ]
}
